FROM node:22-alpine
RUN apk add --no-cache curl ca-certificates ffmpeg espeak sox
WORKDIR /app
COPY agent-system/package.json /app/
COPY agent-system/shared/ /app/shared/
COPY agent-system/services/media/ /app/services/media/
RUN npm install --production
EXPOSE 3002
CMD ["node","services/media/index.js"]
