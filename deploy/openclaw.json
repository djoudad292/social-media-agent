{
  "agents": {
    "defaults": {
      "workspace": "/data/openclaw/workspace",
      "model": {
        "primary": "openai/gpt-5-mini"
      },
      "models": {
        "openai/gpt-5-mini": { "alias": "GPT-5 Mini (Azure)" },
        "openai/gpt-5-nano": { "alias": "GPT-5 Nano (Azure)" }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "port": 10000,
    "bind": "lan",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "models": {
    "providers": {
      "openai": {
        "api": "openai-completions",
        "apiKey": "azure-proxy",
        "baseUrl": "http://localhost:42789/v1",
        "models": [
          {
            "id": "gpt-5-mini",
            "name": "GPT-5 Mini (Azure)"
          },
          {
            "id": "gpt-5-nano",
            "name": "GPT-5 Nano (Azure)"
          }
        ]
      },
      "google-generative-ai": {
        "api": "google-generative-ai",
        "apiKey": "${GEMINI_API_KEY}",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "models": [
          {
            "id": "gemini-2.0-flash",
            "name": "Gemini 2.0 Flash"
          }
        ]
      }
    }
  },
  "auth": {
    "profiles": {
      "openai:default": {
        "provider": "openai",
        "mode": "api_key"
      }
    },
    "order": {
      "openai": [
        "openai:default"
      ]
    }
  },
  "tools": {
    "profile": "coding"
  },
  "plugins": {
    "entries": {
      "openai": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ],
      "botToken": "${TELEGRAM_BOT_TOKEN}"
    }
  },
  "skills": {
    "entries": {
      "social-poster": {
        "enabled": true,
        "env": {
          "FACEBOOK_ACCESS_TOKEN": "${FACEBOOK_ACCESS_TOKEN}",
          "PEXELS_API_KEY": "${PEXELS_API_KEY}",
          "GEMINI_API_KEY": "${GEMINI_API_KEY}",
          "MAGIC_HOUR_API_KEY": "${MAGIC_HOUR_API_KEY}",
          "UDIO_API_KEY": "${UDIO_API_KEY}",
          "REAPI_API_KEY": "${REAPI_API_KEY}",
          "DUB_API_KEY": "${DUB_API_KEY}",
          "JINA_API_KEY": "${JINA_API_KEY}",
          "AZURE_SPEECH_KEY": "${AZURE_SPEECH_KEY}",
          "AZURE_SPEECH_REGION": "${AZURE_SPEECH_REGION}",
          "AZURE_STORAGE_CONNECTION_STRING": "${AZURE_STORAGE_CONNECTION_STRING}",
          "AZURE_STORAGE_CONTAINER": "${AZURE_STORAGE_CONTAINER}"
        }
      },
      "comment-bot": {
        "enabled": true,
        "env": {
          "FACEBOOK_ACCESS_TOKEN": "${FACEBOOK_ACCESS_TOKEN}"
        }
      },
      "content-writer": {
        "enabled": true,
        "env": {
          "GEMINI_API_KEY": "${GEMINI_API_KEY}",
          "FREENEWS_API_KEY": "${FREENEWS_API_KEY}",
          "JINA_API_KEY": "${JINA_API_KEY}"
        }
      },
      "analytics": {
        "enabled": true
      },
      "lead-hunter": {
        "enabled": true,
        "env": {
          "RESEND_API_KEY": "${RESEND_API_KEY}"
        }
      },
      "social-strategy": {
        "enabled": true,
        "env": {
          "FREENEWS_API_KEY": "${FREENEWS_API_KEY}",
          "DUB_API_KEY": "${DUB_API_KEY}",
          "RESEND_API_KEY": "${RESEND_API_KEY}"
        }
      }
    }
  }
}
