{
  "agents": {
    "defaults": {
      "workspace": "/data/openclaw/workspace",
      "model": {
        "primary": "openai/google/gemma-4-26b-a4b-it:free"
      },
      "models": {
        "openai/google/gemma-4-26b-a4b-it:free": {
          "alias": "Gemma 4 Free"
        },
        "openai/nvidia/nemotron-3-nano-30b-a3b:free": {
          "alias": "Nemotron Free"
        },
        "openai/qwen/qwen3-coder:free": {
          "alias": "Qwen Coder Free"
        },
        "azure-openai/gpt-5-mini": {
          "alias": "Azure GPT-5 Mini"
        },
        "azure-openai/gpt-5-nano": {
          "alias": "Azure GPT-5 Nano"
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "port": 10000,
    "bind": "lan",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "models": {
    "providers": {
      "openai": {
        "api": "openai-responses",
        "apiKey": "${OPENAI_API_KEY}",
        "baseUrl": "https://openrouter.ai/api/v1",
        "models": [
          {
            "id": "google/gemma-4-26b-a4b-it:free",
            "name": "Gemma 4 Free"
          },
          {
            "id": "nvidia/nemotron-3-nano-30b-a3b:free",
            "name": "Nemotron Free"
          },
          {
            "id": "qwen/qwen3-coder:free",
            "name": "Qwen Coder Free"
          },
          {
            "id": "openrouter/free",
            "name": "OpenRouter Auto Free"
          }
        ]
      },
      "google-generative-ai": {
        "api": "google-generative-ai",
        "apiKey": "${GEMINI_API_KEY}",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "models": [
          {
            "id": "gemini-2.0-flash",
            "name": "Gemini 2.0 Flash"
          }
        ]
      },
      "azure-openai": {
        "api": "openai-responses",
        "apiKey": "${AZURE_OPENAI_API_KEY}",
        "baseUrl": "${AZURE_OPENAI_ENDPOINT}",
        "models": [
          {
            "id": "gpt-5-mini",
            "name": "GPT-5 Mini (Azure)"
          },
          {
            "id": "gpt-5-nano",
            "name": "GPT-5 Nano (Azure)"
          }
        ]
      }
    }
  },
  "auth": {
    "profiles": {
      "openai:default": {
        "provider": "openai",
        "mode": "api_key"
      },
      "azure-openai:default": {
        "provider": "azure-openai",
        "mode": "api_key"
      }
    },
    "order": {
      "openai": [
        "openai:default"
      ],
      "azure-openai": [
        "azure-openai:default"
      ]
    }
  },
  "tools": {
    "profile": "coding"
  },
  "plugins": {
    "entries": {
      "openai": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "open",
      "allowFrom": [
        "*"
      ]
    }
  },
  "skills": {
    "entries": {
      "social-poster": {
        "enabled": true,
        "env": {
          "FACEBOOK_ACCESS_TOKEN": "${FACEBOOK_ACCESS_TOKEN}",
          "PEXELS_API_KEY": "${PEXELS_API_KEY}",
          "GEMINI_API_KEY": "${GEMINI_API_KEY}",
          "MAGIC_HOUR_API_KEY": "${MAGIC_HOUR_API_KEY}",
          "UDIO_API_KEY": "${UDIO_API_KEY}",
          "REAPI_API_KEY": "${REAPI_API_KEY}",
          "DUB_API_KEY": "${DUB_API_KEY}",
          "JINA_API_KEY": "${JINA_API_KEY}",
          "AZURE_SPEECH_KEY": "${AZURE_SPEECH_KEY}",
          "AZURE_SPEECH_REGION": "${AZURE_SPEECH_REGION}",
          "AZURE_STORAGE_CONNECTION_STRING": "${AZURE_STORAGE_CONNECTION_STRING}",
          "AZURE_STORAGE_CONTAINER": "${AZURE_STORAGE_CONTAINER}"
        }
      },
      "comment-bot": {
        "enabled": true,
        "env": {
          "FACEBOOK_ACCESS_TOKEN": "${FACEBOOK_ACCESS_TOKEN}"
        }
      },
      "content-writer": {
        "enabled": true,
        "env": {
          "GEMINI_API_KEY": "${GEMINI_API_KEY}",
          "FREENEWS_API_KEY": "${FREENEWS_API_KEY}",
          "JINA_API_KEY": "${JINA_API_KEY}"
        }
      },
      "analytics": {
        "enabled": true
      },
      "lead-hunter": {
        "enabled": true,
        "env": {
          "RESEND_API_KEY": "${RESEND_API_KEY}"
        }
      },
      "social-strategy": {
        "enabled": true,
        "env": {
          "FREENEWS_API_KEY": "${FREENEWS_API_KEY}",
          "DUB_API_KEY": "${DUB_API_KEY}",
          "RESEND_API_KEY": "${RESEND_API_KEY}"
        }
      }
    }
  },
  "crons": {
    "keep-alive": {
      "schedule": "*/5 * * * *",
      "task": "curl -s https://social-media-agent-ia4m.onrender.com/health > /dev/null",
      "description": "Keep Render awake every 5 minutes"
    }
  }
}