# Required — Gateway auth token (generate with: openssl rand -hex 24)
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# Required — OpenRouter API key for primary AI model
OPENAI_API_KEY=sk-or-v1-...

# Required — OpenRouter base URL
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Required — Pexels API key for stock footage in reels
PEXELS_API_KEY=VeuIwHzRnoF4BpCUaXptBUAySciVaMY0b4ozaK5SpPsngnnlY6KtYo2e

# Optional — Gemini API key (images, TTS, fallback model)
GEMINI_API_KEY=AIzaSy...

# Optional — Facebook Page Access Token for social-poster skill
FACEBOOK_ACCESS_TOKEN=EAAO...

# ── New API Keys (July 2026) ─────────────────────────────────────────

# Magic Hour — AI video (Veo 3.1, LTX 2.3), image, and voice generation
# Docs: https://docs.magichour.ai
MAGIC_HOUR_API_KEY=mhk_live_...

# UdioAPI.pro — AI music generation (Suno V4, Udio, Stable Audio)
# API: https://udioapi.pro/api/v2/generate
UDIO_API_KEY=sk-...

# reAPI — HappyHorse 1.0, Kling 3.0 video + Midjourney V7 images
# Docs: https://reapi.ai/docs
REAPI_API_KEY=LHOoVvsi...

# free.ai — Seedance 2.0 video (OpenAI-compatible, 30K tokens/day)
# API: https://api.free.ai/v1/video/generate/
FREEAI_API_KEY=sk-...

# Dub.co — Branded short links with click analytics (domain: djaouad-tech.com)
# Docs: https://dub.co/docs/api-reference
DUB_API_KEY=dub_...

# Jina AI Reader — Turn any URL into clean Markdown for the agent
# Usage: https://r.jina.ai/<URL> (Bearer auth)
JINA_API_KEY=jina_...

# FreeNewsApi — Real-time news for content inspiration (5K req/day free)
# API: https://api.freenewsapi.io/v1/news (X-API-Key header)
FREENEWS_API_KEY=...

# Resend — Transactional email / newsletters (3K emails/mo free)
# Docs: https://resend.com/docs
RESEND_API_KEY=re_...
