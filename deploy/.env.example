# Required — Gateway auth token (generate with: openssl rand -hex 24)
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# Required — OpenRouter API key for primary AI model
OPENAI_API_KEY=sk-or-v1-...

# Optional — Gemini API key (fallback model, free tier has quota limits)
GEMINI_API_KEY=AIzaSy...

# Required — OpenRouter base URL (so OpenAI-compatible requests route correctly)
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional — Facebook Page Access Token for social-poster skill
FACEBOOK_ACCESS_TOKEN=EAAO...
